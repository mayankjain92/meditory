# AWS Configuration
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Local DynamoDB (Uncomment for offline Docker development)
DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB Single Table
MEDITORY_TABLE_NAME=MeditorySingleTable

# JWT Signing Secret (For local development/mocking)
JWT_SECRET=meditory_super_secret_jwt_key_bharat_2026_change_in_production

# Frontend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# SMTP Email Delivery (Optional: If left empty, uses automatic Ethereal test inbox with preview URLs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Meditory District Health Authority <notifications@meditory.gov.in>"
