    "@meditory/shared": "workspace:*",
    "aws-cdk-lib": "^2.140.0",
    "bcryptjs": "^2.4.3",
    "constructs": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
