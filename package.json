{
  "name": "meditory",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic-to-Clinic Healthcare Inventory & Emergency Referral Network for Bharat",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter api --filter web --filter admin --parallel dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:all": "pnpm -r build",
    "cdk": "pnpm --filter api cdk",
    "cdk:synth": "pnpm --filter api cdk:synth",
    "cdk:deploy": "pnpm --filter api cdk:deploy",
    "ddb:local": "docker compose up -d",
    "ddb:stop": "docker compose down",
    "ddb:inspect": "pnpm --filter api inspect",
    "seed": "pnpm --filter api seed",
    "clean:db": "pnpm --filter api clean:db",
    "inspect": "pnpm --filter api inspect",
    "test": "pnpm --filter api test:handlers",
    "test:handlers": "pnpm --filter api test:handlers"
  },
  "keywords": [
    "aws",
    "healthcare",
    "inventory",
    "serverless",
    "dynamodb",
    "nextjs"
  ],
  "author": "Mayank",
  "license": "MIT"
}
