{
  "name": "meditory",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic-to-Clinic Healthcare Inventory & Emergency Referral Network for Bharat",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:all": "pnpm -r build",
    "cdk": "pnpm --filter api cdk",
    "cdk:synth": "pnpm --filter api cdk:synth",
    "cdk:deploy": "pnpm --filter api cdk:deploy",
    "seed": "pnpm --filter api seed"
  },
  "keywords": [
    "aws",
    "healthcare",
    "inventory",
    "serverless",
    "dynamodb",
    "nextjs"
  ],
  "author": "Mayank",
  "license": "MIT"
}
